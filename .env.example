# 复制为 .env.local 后填写真实值（勿提交 .env.local）
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端 API 用（创建记录、设置等）；勿暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=

# 可选：保护 /api/health，外部 cron 访问时带 ?token=...
HEALTHCHECK_TOKEN=

# 可选：保活/备份脚本使用
APP_BASE_URL=https://aixinji.linknewai.com
BACKUP_DIR=backups
